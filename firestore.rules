rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow get: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Team members & user profiles
    // Allow reading, creating, updating, and deleting collaborators
    match /users/{userId} {
      allow read, write: if true;
    }

    // Hardware store tasks
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Notifications for assignees
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // Supplier leads & purchase optimization for the owner
    match /supplier_leads/{leadId} {
      allow read, write: if true;
    }
  }
}

